# Backend sin Docker — desarrollo local
# Crear archivo activo:  make env-backend-local   →  backend/.env
# Requiere PostgreSQL en localhost (make up solo postgres, o instalación nativa)

DATABASE_URL=postgresql+asyncpg://tys:tys_dev@localhost:5432/tys_dev

JWT_SECRET=dev-secret-cambia-en-produccion
ENV=development_local
FRONTEND_URL=http://localhost:3000
PUBLIC_DOMAIN=localhost
TYS_FEE_PERCENT=5
DEFAULT_TIMEZONE=America/Guayaquil

STRIPE_API_KEY=
STRIPE_API_BASE=https://api.stripe.com
STRIPE_WEBHOOK_SECRET=

# --- Nuvei Ecuador (Paymentez / ex-Paymentez) ---
# https://developers.paymentez.com/api/#authentication
# Credenciales del partner (App Code + App Key) = par SERVER:
#   NUVEI_SERVER_APP_CODE  (alias: NUVEI_APP_CODE)
#   NUVEI_SERVER_APP_KEY   (alias: NUVEI_APP_KEY)
# Opcional — par CLIENT para el JS modal (si te lo dieron aparte):
#   NUVEI_CLIENT_APP_CODE / NUVEI_CLIENT_APP_KEY
NUVEI_SERVER_APP_CODE=
NUVEI_SERVER_APP_KEY=
NUVEI_ENV=stg
# Override opcional de la URL base de la API (igual que STRIPE_API_BASE)
NUVEI_API_BASE=
# 1 = PaymentGateway usa SERVER en el browser (solo local/stg; no prod)
NUVEI_JS_USE_SERVER=1
# URL pública del backend para webhooks (ngrok / prod). Ej: https://api.tudominio.com
BACKEND_PUBLIC_URL=

# --- DEUNA (Payment Widget) ---
# https://docs.deuna.com/reference/web-sdk
# ApiKey → DEUNA_API_KEY | ApiSecret → DEUNA_API_SECRET | pointOfSales → DEUNA_POINT_OF_SALES
DEUNA_API_KEY=
DEUNA_API_SECRET=
DEUNA_POINT_OF_SALES=
DEUNA_ENV=sandbox

RESEND_API_KEY=
EMAIL_FROM=noreply@ticketyourself.com

ADMIN_EMAIL=admin@ticketyourself.com
ADMIN_PASSWORD=Admin123!
