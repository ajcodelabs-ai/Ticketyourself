# Backend sin Docker — desarrollo local
# Crear archivo activo:  make env-backend-local   →  backend/.env
# Requiere PostgreSQL en localhost (make up solo postgres, o instalación nativa)

DATABASE_URL=postgresql+asyncpg://tys:tys_dev@localhost:5432/tys_dev

JWT_SECRET=dev-secret-cambia-en-produccion
ENV=development_local
FRONTEND_URL=http://localhost:3000
PUBLIC_DOMAIN=localhost
TYS_FEE_PERCENT=5
DEFAULT_TIMEZONE=America/Guayaquil

STRIPE_API_KEY=
STRIPE_API_BASE=https://api.stripe.com
STRIPE_WEBHOOK_SECRET=

# --- Nuvei (Simply Connect / openOrder) ---
# Credenciales del Control Panel Nuvei. Vacío = stub (pending_gateway).
NUVEI_MERCHANT_ID=
NUVEI_MERCHANT_SITE_ID=
NUVEI_SECRET_KEY=
NUVEI_ENV=test
# URL pública del backend para DMNs (ngrok / prod). Ej: https://api.tudominio.com
BACKEND_PUBLIC_URL=

# --- DEUNA (Payment Widget) ---
# https://docs.deuna.com/reference/web-sdk
DEUNA_PRIVATE_API_KEY=
DEUNA_PUBLIC_API_KEY=
DEUNA_STORE_CODE=all
DEUNA_ENV=sandbox

RESEND_API_KEY=
EMAIL_FROM=noreply@ticketyourself.com

ADMIN_EMAIL=admin@ticketyourself.com
ADMIN_PASSWORD=Admin123!
