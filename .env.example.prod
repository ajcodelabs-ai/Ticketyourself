# Producción — Docker Compose (docker-compose.prod.yml)
# Crear archivo activo:  make env-prod   →  .env.prod
# Levantar stack:      make prod-up
#
# IMPORTANTE: no commitees .env.prod. Genera secretos fuertes antes de desplegar.

# --- PostgreSQL ---
POSTGRES_USER=tys
POSTGRES_PASSWORD=
POSTGRES_DB=tys_production

# --- Backend ---
JWT_SECRET=
ENV=production
SEED_DEMO_DATA=false
FRONTEND_URL=https://app.tudominio.com
PUBLIC_DOMAIN=tudominio.com
TYS_FEE_PERCENT=5
# --- Stripe (requerido en producción) ---
STRIPE_API_KEY=sk_live_...
STRIPE_API_BASE=https://api.stripe.com
STRIPE_WEBHOOK_SECRET=whsec_...

# --- OneShot (contratos) ---
ONESHOT_API_KEY=
ONESHOT_API_BASE=
ONESHOT_WEBHOOK_SECRET=
ONESHOT_TEMPLATE_ID=

# --- Nuvei Ecuador (Paymentez) ---
# SERVER App Code + App Key (aliases: NUVEI_APP_CODE / NUVEI_APP_KEY)
NUVEI_SERVER_APP_CODE=
NUVEI_SERVER_APP_KEY=
NUVEI_ENV=prod
BACKEND_PUBLIC_URL=https://api.tudominio.com

# --- DEUNA ---
# ApiKey → DEUNA_API_KEY | ApiSecret → DEUNA_API_SECRET | pointOfSales → DEUNA_POINT_OF_SALES
DEUNA_API_KEY=
DEUNA_API_SECRET=
DEUNA_POINT_OF_SALES=
DEUNA_ENV=production

# --- Login social compradores (Google / Apple) ---
# Un Client ID de plataforma para todos los organizadores.
# Origins en Google Cloud: FRONTEND_URL (ej. https://app.tudominio.com).
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# --- Dátil (facturación electrónica SRI Ecuador) ---
DATIL_API_KEY=
DATIL_CERT_PASSWORD=
DATIL_API_BASE=https://link.datil.co
DATIL_AMBIENTE=2
# Emisor SRI e IVA: registro del organizador + evento (no env).

# --- Verificante (KYC persona natural Ecuador) ---
# Solo EC + persona natural. riskLevel=LOW es señal para el super admin (no aprueba).
VERIFICANTE_API_KEY=
VERIFICANTE_API_BASE=https://dash.verificante.com
VERIFICANTE_WEBHOOK_SECRET=

# --- Resend (opcional, para envío de emails) ---
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@ticketyourself.com

# --- Super admin (cambia la contraseña tras el primer deploy) ---
ADMIN_EMAIL=admin@ticketyourself.com
ADMIN_PASSWORD=

# Zona horaria por defecto (formato IANA, ej: America/Guayaquil)
VITE_DEFAULT_TIMEZONE=America/Guayaquil
VITE_BACKEND_URL=https://api.tudominio.com
VITE_PUBLIC_DOMAIN=tudominio.com
