# Desarrollo local — Docker Compose (docker-compose.yml)
# Crear archivo activo:  make env-local   →  .env
# Levantar stack:        make up

# --- PostgreSQL ---
POSTGRES_USER=tys
POSTGRES_PASSWORD=tys_dev
POSTGRES_DB=tys_dev
POSTGRES_PORT=5432

# Solo para Alembic / backend fuera de Docker (host → localhost)
DATABASE_URL=postgresql+asyncpg://tys:tys_dev@localhost:5432/tys_dev

# --- Backend ---
JWT_SECRET=dev-secret-cambia-en-produccion
ENV=development_local
# true: muestra «Simular pago» en checkout y confirma sin pasarela real.
DEMO_PAYMENTS_ENABLED=true
# true: resetea demo-org en cada arranque. false: no pisa datos (como producción).
SEED_DEMO_DATA=true
FRONTEND_URL=http://localhost:3000
PUBLIC_DOMAIN=localhost
TYS_FEE_PERCENT=5

# --- Frontend (URL que usa el navegador; no uses hostname Docker interno) ---
VITE_BACKEND_URL=http://localhost:8000
VITE_PUBLIC_DOMAIN=localhost

# --- OneShot (contratos; credenciales después) ---
ONESHOT_API_KEY=
ONESHOT_API_BASE=
ONESHOT_WEBHOOK_SECRET=
ONESHOT_TEMPLATE_ID=

# --- Nuvei Ecuador (Paymentez / opcional en local) ---
# Un par …-EC-CLIENT es el JS. …-EC-SERVER firma Checkout v3 (init_reference)
# y Link to Pay. LINKTOPAY…-EC-SERVER es solo noccapi (TYS no llama v3).
NUVEI_CLIENT_APP_CODE=
NUVEI_CLIENT_APP_KEY=
NUVEI_SERVER_APP_CODE=
NUVEI_SERVER_APP_KEY=
# NUVEI_APP_CODE=
# NUVEI_APP_KEY=
NUVEI_ENV=stg
# Callback JSON de Nuvei/Paymentez: {BACKEND_PUBLIC_URL}/api/nuvei/webhook
# https://developers.paymentez.com/api/#webhook
BACKEND_PUBLIC_URL=http://localhost:8000

# --- Login social compradores (Google / Apple) ---
# Un solo Client ID de TYS para TODAS las orgs (no se configura por organizador).
# En Google Cloud: un cliente OAuth "Web" del proyecto Ticket Yourself.
# Authorized JavaScript origins: el origen de ESTA app (ej. http://localhost:3000),
# no cada subdominio de organizador. Si están vacíos, los botones no se muestran.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# --- Dátil (facturación electrónica SRI Ecuador) ---
# https://datil.dev/#introduccion
# API Key: app.datil.co → Configuración → API Key
# X-Password = clave del certificado de firma electrónica
# ambiente: 1 = pruebas (SRI), 2 = producción
DATIL_API_KEY=
DATIL_CERT_PASSWORD=
DATIL_API_BASE=https://link.datil.co
DATIL_AMBIENTE=1
# true: no llama a Dátil; emite un comprobante AUTORIZADO falso (flujo TYS).
# false: llama a Dátil y guarda el JSON en backend/datil_log/ (sin secretos).
DATIL_MOCK=false
# RUC, razón social, dirección, establecimiento e IVA NO van acá:
# se piden al registrar el organizador y al crear el evento.

# --- Verificante (KYC persona natural Ecuador) ---
# https://dash.verificante.com/api/v1/docs
# Solo se llama al registrar org_type=individual + country=EC.
# riskLevel=LOW es una señal para el super admin; no aprueba la cuenta.
VERIFICANTE_API_KEY=
VERIFICANTE_API_BASE=https://dash.verificante.com
VERIFICANTE_WEBHOOK_SECRET=
# true: no llama a Verificante; trata la cédula como riesgo bajo (ignorado si ENV=production).
VERIFICANTE_MOCK=true

# --- Email / Resend (opcional en local) ---
# EMAIL_FROM must be an address on a domain verified in Resend.
# onboarding@resend.dev only delivers to the Resend account owner.
RESEND_API_KEY=
EMAIL_FROM=noreply@mail.tudominio.com

# --- Super admin (seed al arrancar) ---
ADMIN_EMAIL=admin@ticketyourself.com
ADMIN_PASSWORD=Admin123!

# Zona horaria por defecto (formato IANA, ej: America/Guayaquil)
VITE_DEFAULT_TIMEZONE=America/Guayaquil
